{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./",
    "resolveJsonModule": true,
    "declaration": true
  },
  "include": [
    "src/**/*",
    "scripts/**/*",
    "test/**/*",
    "circuits-test/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "target",
    "out",
    "cache"
  ]
}
