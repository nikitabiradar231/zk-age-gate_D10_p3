pragma solidity >=0.8.21;

import "forge-std/Test.sol";
import "../contracts/generated/AgeGateVerifier.sol";
import "../contracts/interfaces/IAgeVerifier.sol";

contract AgeGateVerifierTest is Test {
    AgeGateVerifier public verifier;

    bytes public realProof;
    bytes32[] public realPublicInputs;

    function setUp() public {
        verifier = new AgeGateVerifier();

        // Read real Barretenberg UltraHonk proof generated by scripts/generate-proof.ts
        string memory json = vm.readFile("test/fixtures/proof_fixture.json");
        realProof = vm.parseJsonBytes(json, ".proofHex");
        realPublicInputs = vm.parseJsonBytes32Array(json, ".publicInputs");
    }

    /// @notice Test that the real UltraHonk proof passes verification with authentic public inputs.
    function test_RealProofVerifiesSuccessfully() public view {
        bool isValid = verifier.verify(realProof, realPublicInputs);
        assertTrue(isValid, "Real proof must verify successfully");
    }

    /// @notice Test that tampering with the proof bytes causes verification to revert or fail.
    function test_TamperedProofFails() public {
        bytes memory tampered = new bytes(realProof.length);
        for (uint256 i = 0; i < realProof.length; i++) {
            tampered[i] = realProof[i];
        }
        // Flip one byte in the proof body
        tampered[50] = bytes1(uint8(tampered[50]) ^ 0xff);

        // Barretenberg UltraHonk verifier reverts or returns false on tampered proof
        try verifier.verify(tampered, realPublicInputs) returns (bool valid) {
            assertFalse(valid, "Tampered proof must not return true");
        } catch {
            // Revert on tampered proof is also correct behavior
        }
    }

    /// @notice Test that wrong claimant address public input causes verification to revert or fail.
    function test_WrongClaimantPublicInputFails() public {
        bytes32[] memory modifiedInputs = new bytes32[](realPublicInputs.length);
        for (uint256 i = 0; i < realPublicInputs.length; i++) {
            modifiedInputs[i] = realPublicInputs[i];
        }
        // Change claimant address in publicInputs[0] to an attacker address
        modifiedInputs[0] = bytes32(uint256(uint160(address(0x1337))));

        try verifier.verify(realProof, modifiedInputs) returns (bool valid) {
            assertFalse(valid, "Proof with modified claimant must fail verification");
        } catch {
            // Revert is expected
        }
    }

    /// @notice Test that wrong nullifier public input causes verification to fail.
    function test_WrongNullifierPublicInputFails() public {
        bytes32[] memory modifiedInputs = new bytes32[](realPublicInputs.length);
        for (uint256 i = 0; i < realPublicInputs.length; i++) {
            modifiedInputs[i] = realPublicInputs[i];
        }
        // Flip byte in nullifier (publicInputs[8])
        modifiedInputs[8] = bytes32(uint256(modifiedInputs[8]) ^ 0x01);

        try verifier.verify(realProof, modifiedInputs) returns (bool valid) {
            assertFalse(valid, "Proof with modified nullifier must fail verification");
        } catch {
            // Revert is expected
        }
    }

    /// @notice Test that wrong reference date public input causes verification to fail.
    function test_WrongReferenceDatePublicInputFails() public {
        bytes32[] memory modifiedInputs = new bytes32[](realPublicInputs.length);
        for (uint256 i = 0; i < realPublicInputs.length; i++) {
            modifiedInputs[i] = realPublicInputs[i];
        }
        // Change reference year (publicInputs[3]) to 2030
        modifiedInputs[3] = bytes32(uint256(2030));

        try verifier.verify(realProof, modifiedInputs) returns (bool valid) {
            assertFalse(valid, "Proof with modified reference year must fail verification");
        } catch {
            // Revert is expected
        }
    }

    /// @notice Test that truncated proof is rejected with ProofLengthWrong.
    function test_TruncatedProofRejects() public {
        bytes memory truncated = new bytes(100);
        vm.expectRevert();
        verifier.verify(truncated, realPublicInputs);
    }
}
